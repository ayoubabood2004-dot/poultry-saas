{
  "comment": "تصنيف الجداول (خطّة المرحلة 1 §2.10، E1): مصدر واحد للقاعدة والحرّاس. catalog.test يقارن الكتالوج بيه بالضبط، وwrite-guard يشتقّ منه «ما يكتبه إلا دالّة»، وreports-guard يشتقّ «جداول المال». كل جدول public بصنف كتابة واحد: functionOnly (الكتابة من الدوالّ بس) أو directWrite (بسياسة كتابة وامتيازاتها وفعلها: { privileges, action }، واختياري draft: true لرأس مسوّدة فسياسته تشرط status = 'draft'، وscope: «in_scope_wh(warehouse_id)» لدالّة النطاق على عمود الصفّ (أو { insert, update } لكل أمر دالّته: المواقع والمخازن من 0005، FOUNDATION ٥٤٤)، وcolumns: { insert: [...], update: [...] } إذا المنح على أعمدة (من 0005 كل جداول البيانات الأساسية: المنشأة والنسخة والمحسوب يكتبها الخادم)؛ وcatalog.test يشرط بكل سياسة كتابة org_id = (select auth_org()) وcan(action) بلا OR). والوسوم: appendOnly (مشغّلات reject_change)، وcostRestricted وaccountsRestricted وsalesRestricted (السياسة المقيِّدة)، وglobal (بلا org_id). reserved: جداول المراحل الجاية اللي الحرّاس يحرسونها من هسه؛ الحزمة اللي تنشئ جدولاً تنقله من reserved لصنفه، وcatalog.test يرفض جدولاً موجوداً وباقي بـreserved.",
  "functionOnly": ["audit_log", "divisions", "ledger_books", "member_scopes", "members", "orgs", "period_locks", "rpc_refs", "units"],
  "directWrite": {
    "expense_categories": {
      "privileges": ["insert", "update"],
      "action": "expense_categories.manage",
      "columns": {
        "insert": ["name"],
        "update": ["name", "archived_at"]
      }
    },
    "item_categories": {
      "privileges": ["insert", "update"],
      "action": "stores.manage",
      "columns": {
        "insert": ["name"],
        "update": ["name", "archived_at"]
      }
    },
    "item_units": {
      "privileges": ["insert", "update"],
      "action": "stores.manage",
      "columns": {
        "insert": ["item_id", "pack_type_id", "label", "factor_to_base", "is_default", "for_purchase", "for_sale", "for_recipe"],
        "update": ["label", "factor_to_base", "is_default", "for_purchase", "for_sale", "for_recipe", "archived_at"]
      }
    },
    "items": {
      "privileges": ["insert", "update"],
      "action": "stores.manage",
      "columns": {
        "insert": ["name", "category_id", "kind", "base_unit", "density_kg_per_l", "piece_mass_kg", "tracks_expiry", "scale_step", "min_qty", "barcode", "alt_codes"],
        "update": ["name", "category_id", "kind", "base_unit", "density_kg_per_l", "piece_mass_kg", "tracks_expiry", "scale_step", "min_qty", "barcode", "alt_codes", "archived_at"]
      }
    },
    "pack_types": {
      "privileges": ["insert", "update"],
      "action": "stores.manage",
      "columns": {
        "insert": ["label", "dimension", "factor"],
        "update": ["label", "archived_at"]
      }
    },
    "sites": {
      "privileges": ["insert", "update"],
      "action": "stores.manage",
      "scope": { "insert": "in_scope_division(division_id)", "update": "in_scope_site(id)" },
      "columns": {
        "insert": ["division_id", "name", "kind"],
        "update": ["name", "archived_at"]
      }
    },
    "warehouses": {
      "privileges": ["insert", "update"],
      "action": "stores.manage",
      "scope": { "insert": "in_scope_site(site_id)", "update": "in_scope_wh(id)" },
      "columns": {
        "insert": ["division_id", "site_id", "name", "kind"],
        "update": ["name", "archived_at"]
      }
    }
  },
  "appendOnly": ["audit_log", "units"],
  "costRestricted": ["audit_log"],
  "accountsRestricted": [],
  "salesRestricted": [],
  "global": ["units"],
  "reserved": {
    "functionOnly": ["cash_moves", "client_versions", "doc_counters", "expenses", "flock_close_values", "flock_costs", "flock_counts", "flock_daily", "flock_day_rejects", "hatch_batch_values", "hatch_candlings", "hatch_costs", "party_allocations", "party_entries", "party_offsets", "production_input_values", "production_values", "receipt_charge_shares", "receipt_revaluations", "sales_line_costs", "sales_line_sources", "sales_return_line_sources", "stock_balances", "stock_lots", "stock_moves"],
    "money": ["cash_accounts", "cash_moves", "expenses", "flock_close_values", "flock_costs", "hatch_batch_values", "hatch_costs", "opening_lines", "party_allocations", "party_entries", "party_offsets", "production_costs", "production_input_values", "production_values", "receipt_amounts", "receipt_charge_lines", "receipt_charge_shares", "receipt_charges", "receipt_line_amounts", "receipt_revaluations", "sales_invoices", "sales_line_costs", "sales_line_sources", "sales_lines", "sales_return_line_sources", "sales_return_lines", "sales_returns", "stock_balances", "stock_count_line_costs", "stock_lots", "stock_moves", "supplier_return_line_amounts"]
  }
}
